{
  "name": "@jthum/framework",
  "version": "0.0.0",
  "private": true,
  "description": "A portable information-system specification and reference TypeScript kernel.",
  "files": [
    "dist",
    "src/svelte",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "development": "./src/index.ts",
      "import": "./dist/index.mjs"
    },
    "./blocks": {
      "types": "./dist/blocks/index.d.mts",
      "development": "./src/blocks/index.ts",
      "import": "./dist/blocks/index.mjs"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.mts",
      "development": "./src/catalog/index.ts",
      "import": "./dist/catalog/index.mjs"
    },
    "./client": {
      "types": "./dist/client/index.d.mts",
      "development": "./src/client/index.ts",
      "import": "./dist/client/index.mjs"
    },
    "./errors": {
      "types": "./dist/errors/index.d.mts",
      "development": "./src/errors/index.ts",
      "import": "./dist/errors/index.mjs"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.mts",
      "development": "./src/kernel/index.ts",
      "import": "./dist/kernel/index.mjs"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.mts",
      "development": "./src/persistence/index.ts",
      "import": "./dist/persistence/index.mjs"
    },
    "./spec": {
      "types": "./dist/spec/index.d.mts",
      "development": "./src/spec/index.ts",
      "import": "./dist/spec/index.mjs"
    },
    "./sqlite": {
      "types": "./dist/sqlite/index.d.mts",
      "development": "./src/sqlite/index.ts",
      "import": "./dist/sqlite/index.mjs"
    },
    "./sqlite/node": {
      "types": "./dist/sqlite/node-index.d.mts",
      "development": "./src/sqlite/node-index.ts",
      "import": "./dist/sqlite/node-index.mjs"
    },
    "./svelte/utils": {
      "types": "./src/svelte/utils.ts",
      "import": "./src/svelte/utils.ts"
    },
    "./svelte/hooks/is-mobile.svelte": {
      "types": "./src/svelte/hooks/is-mobile.svelte.ts",
      "import": "./src/svelte/hooks/is-mobile.svelte.ts"
    },
    "./svelte/theme.css": "./src/svelte/theme.css",
    "./svelte/authoring": {
      "types": "./src/svelte/authoring/index.ts",
      "svelte": "./src/svelte/authoring/index.ts",
      "import": "./src/svelte/authoring/index.ts"
    },
    "./svelte/authoring/adapters": {
      "types": "./src/svelte/authoring/adapters.ts",
      "import": "./src/svelte/authoring/adapters.ts"
    },
    "./svelte/authoring/data": {
      "types": "./src/svelte/authoring/data.ts",
      "import": "./src/svelte/authoring/data.ts"
    },
    "./svelte/authoring/*": {
      "types": "./src/svelte/authoring/*.svelte",
      "svelte": "./src/svelte/authoring/*.svelte",
      "import": "./src/svelte/authoring/*.svelte"
    },
    "./svelte/operations": {
      "types": "./src/svelte/operations/index.ts",
      "svelte": "./src/svelte/operations/index.ts",
      "import": "./src/svelte/operations/index.ts"
    },
    "./svelte/operations/*": {
      "types": "./src/svelte/operations/*.svelte",
      "svelte": "./src/svelte/operations/*.svelte",
      "import": "./src/svelte/operations/*.svelte"
    },
    "./svelte/settings": {
      "types": "./src/svelte/settings/index.ts",
      "svelte": "./src/svelte/settings/index.ts",
      "import": "./src/svelte/settings/index.ts"
    },
    "./svelte/settings/settings-layout": {
      "types": "./src/svelte/settings/settings-layout.ts",
      "import": "./src/svelte/settings/settings-layout.ts"
    },
    "./svelte/settings/*": {
      "types": "./src/svelte/settings/*.svelte",
      "svelte": "./src/svelte/settings/*.svelte",
      "import": "./src/svelte/settings/*.svelte"
    },
    "./svelte/ui/*": {
      "types": "./src/svelte/ui/*/index.ts",
      "svelte": "./src/svelte/ui/*/index.ts",
      "import": "./src/svelte/ui/*/index.ts"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.svelte.json",
    "test": "vp test"
  },
  "dependencies": {
    "@lucide/svelte": "^1.46.0",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "nanoid": "^6.0.1",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.4.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  }
}
