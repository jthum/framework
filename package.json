{
  "name": "@jthum/framework",
  "version": "0.0.0",
  "private": true,
  "description": "A portable information-system specification and reference TypeScript kernel.",
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./errors": {
      "types": "./dist/errors/index.d.mts",
      "import": "./dist/errors/index.mjs"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.mts",
      "import": "./dist/kernel/index.mjs"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.mts",
      "import": "./dist/persistence/index.mjs"
    },
    "./spec": {
      "types": "./dist/spec/index.d.mts",
      "import": "./dist/spec/index.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test"
  },
  "dependencies": {
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  }
}
